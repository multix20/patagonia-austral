# URL del backend Laravel (dejar vacio para usar datos semilla locales)
# En produccion: la URL del backend en Render (p. ej. https://patagonia-austral-api.onrender.com)
VITE_API_URL=

# Clave publica VAPID del backend (para Web Push). Es publica, no secreta.
VITE_VAPID_PUBLIC_KEY=

# API key de Stadia Maps para el basemap de terreno de la capa "Mapa"
# (stamen_terrain_background: verde de bosque tipo Google Maps). Es una clave de
# CLIENTE, restringida por dominio en el panel de Stadia (no un secreto). Se
# registra gratis en https://stadiamaps.com. Si se deja vacia, la capa "Mapa"
# cae de vuelta a CARTO Voyager (el mapa NO se rompe). Ver DEPLOY.md.
VITE_STADIA_API_KEY=
